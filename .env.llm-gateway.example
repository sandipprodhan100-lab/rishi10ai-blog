# Copy to .env.llm-gateway and fill in values.
# Works with any Anthropic-compatible LLM gateway (9router, LiteLLM, etc.).
# Used by app-side LLM calls and mirrored into .claude/settings.local.json
# so Claude Code sessions launched from this folder route through the gateway.
LLM_GATEWAY_NAME=9router
LLM_GATEWAY_URL=http://127.0.0.1:20128/v1
LLM_GATEWAY_API_KEY=

# Default model id as exposed by the gateway.
LLM_GATEWAY_MODEL=
