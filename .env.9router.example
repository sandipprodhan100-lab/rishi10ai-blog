# Copy this file to .env.9router and fill in values.
# Use the 9router Anthropic-compatible endpoint URL.
NINE_ROUTER_URL=http://127.0.0.1:20128/v1

# Optional if your 9router instance requires authentication.
NINE_ROUTER_API_KEY=your-9router-api-key

# Optional centralized model override used by the global router script.
# Use the Mycombo route created in 9Router.
LLM_GATEWAY_MODEL=Mycombo
